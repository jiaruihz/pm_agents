# Weather Dashboard dev commands
# Usage: make -f Makefile.weather <target>

VENV     := .venv/bin
PYTHON   := $(VENV)/python
DB_PATH  := runtime/weather.db
API_PORT := 8000
FE_DIR   := frontend/strategy_dashboard

.PHONY: help test api fe ingest-sample ingest-real db-init db-canonical-init db-canonical-rebuild migrate-legacy-research migrate-live-cycle metrics-refresh cleanup-orphans clob-fill-sync

help:
	@echo "Weather Dashboard targets:"
	@echo "  test              — run all weather_dashboard tests"
	@echo "  api               — show controller-managed API health (does not start uvicorn)"
	@echo "  fe                — start React dev server (port 5173)"
	@echo "  db-init           — LEGACY v1 schema init; canonical users should use db-canonical-init"
	@echo "  db-canonical-init — initialise canonical DB schema at $(DB_PATH)"
	@echo "  db-canonical-rebuild — explicit run_stack full rebuild; does not start services"
	@echo "  migrate-legacy-research — migrate T24 research CSVs into canonical DB"
	@echo "  migrate-live-cycle — migrate live-cycle JSONL lineage into canonical DB"
	@echo "  ingest-real       — LEGACY v1 ingest; do not use for canonical rebuilds"
	@echo "  metrics-refresh   — recompute and persist metrics for all runs"
	@echo "  cleanup-orphans   — list/delete runs with 0 fills (add DRY=1 to preview)"
	@echo "  clob-fill-sync    — sync CLOB fill status for submitted orders (add DRY=1 for dry-run)"
	@echo "  clean-db          — retired; use explicit run_stack --recreate-db authorization"

test:
	$(PYTHON) -m pytest tests/weather_dashboard/ -v

api:
	$(PYTHON) scripts/ops/weather_production_ctl.py health

fe:
	cd $(FE_DIR) && npm run dev -- --host 0.0.0.0

db-init:
	@if [ "$(ALLOW_LEGACY_V1)" != "1" ]; then \
	  echo "ERROR: db-init is legacy v1. Use db-canonical-init/db-canonical-rebuild, or set ALLOW_LEGACY_V1=1 intentionally." >&2; \
	  exit 2; \
	fi
	$(PYTHON) -c "from weather_dashboard.db.apply_schema import init_db; init_db('$(DB_PATH)')"
	@echo "DB initialised at $(DB_PATH)"

db-canonical-init:
	$(PYTHON) -c "from weather_dashboard.db.apply_schema_canonical import init_db_canonical; init_db_canonical('$(DB_PATH)')"
	@echo "Canonical DB initialised at $(DB_PATH)"

db-canonical-rebuild:
	scripts/weather_dashboard/run_stack.sh --rebuild

migrate-legacy-research: db-canonical-init
	$(PYTHON) -m weather_dashboard.cli.ingest_legacy_research --db-path $(DB_PATH)

migrate-live-cycle: db-canonical-init
	$(PYTHON) -m weather_dashboard.cli.ingest_live_cycle --db-path $(DB_PATH)

ingest-real: db-init
	@echo "WARNING: ingest-real is legacy v1. Prefer migrate-legacy-research for canonical DB." >&2
	$(PYTHON) -m weather_dashboard.cli.ingest_run \
	  --csv runtime/weather_edge_v1/market_data/research/t24_paper_snapshot_replay_trades.csv \
	  --db-path $(DB_PATH) \
	  --run-name snapshot_replay_t24 \
	  --execution-mode snapshot_replay \
	  --config-name weather_edge_v1 \
	  --config-params '{"min_edge": 0.08}' \
	  --universe-name "T24 Cities" \
	  --date-range-start 2026-05-05 \
	  --date-range-end 2026-05-15 \
	  --state explore

ingest-paper: db-init
	@echo "WARNING: ingest-paper is legacy v1. Prefer migrate-legacy-research for canonical DB." >&2
	$(PYTHON) -m weather_dashboard.cli.ingest_run \
	  --csv runtime/weather_edge_v1/market_data/research/t24_paper_ledger_trades.csv \
	  --db-path $(DB_PATH) \
	  --run-name paper_t24 \
	  --execution-mode paper \
	  --config-name weather_edge_v1 \
	  --config-params '{"min_edge": 0.08}' \
	  --universe-name "T24 Cities" \
	  --state paper

metrics-refresh:
	$(PYTHON) -c "\
from weather_dashboard.db.connection import get_conn; \
from weather_dashboard.metrics.save import save_all_metrics; \
conn = get_conn('$(DB_PATH)'); \
results = save_all_metrics(conn); \
conn.close(); \
print(f'Updated metrics for {len(results)} run(s)')"

cleanup-orphans:
	$(PYTHON) -m weather_dashboard.cli.cleanup --db-path $(DB_PATH) \
	  $(if $(DRY),--dry-run) $(if $(ALL),--all-orphans)

clob-fill-sync:
	$(PYTHON) -m weather_dashboard.ingest.clob_fill_sync --db-path $(DB_PATH) \
	  $(if $(DRY),--dry-run) $(if $(V),--verbose)

clean-db:
	@echo "ERROR: direct clean-db is retired; use run_stack.sh --recreate-db only with explicit authorization" >&2
	@exit 2
