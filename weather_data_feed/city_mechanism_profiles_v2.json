{
  "schema_version": "city_mechanism_profiles_v2",
  "purpose": "Descriptive multi-axis research metadata. This file contains no trading permissions, allowlists, or gates.",
  "axis_schema": {
    "geography": {
      "fields": ["legacy_context", "latitude", "longitude", "hemisphere"],
      "provenance_required": true
    },
    "terrain": {
      "fields": ["classification", "elevation_m", "legacy_hint"],
      "provenance_required": true
    },
    "coastal": {
      "fields": ["classification", "coast_normal_bearing_deg", "orientation_status"],
      "provenance_required": true
    },
    "source_topology": {
      "fields": ["settlement_source_class", "primary_observation_source", "fallback_observation_sources"],
      "provenance_required": true
    },
    "forecast_topology": {
      "fields": ["assigned_model", "regional_model_availability"],
      "provenance_required": true
    }
  },
  "shared_provenance": {
    "legacy_weather_context": "weather_data_feed/weather_context.py:CITY_WIND_CONTEXT",
    "legacy_city_family": "weather_data_feed/city_family.py",
    "source_topology": "weather_data_feed/source_profiles.json",
    "forecast_topology": "not yet materialized in a shared static registry"
  },
