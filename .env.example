# =========================
# PMM (Market Maker)
# =========================
# Shared execution gateway (recommended for both PMM/ARB)
PM_API_BASE_URL="http://localhost:8000"
PM_API_KEY=""
PMM_TOKEN_IDS=""
PMM_EXECUTION_MODE="paper"   # paper | live
PMM_MARKET_DATA_SOURCE="rest" # rest | ws
PMM_STRATEGY_KEY="multi_level_v1" # single_level_v1 | multi_level_v1
PMM_DRY_RUN="1"

# Paper backtest / simulation
PMM_PAPER_INITIAL_USDC="1000"
PMM_PAPER_FILL_MODEL="conservative" # conservative | optimistic
PMM_PRICE_TICK="0.001"
PMM_BASE_SIZE="5"
PMM_MAX_POSITION="100"
PMM_GUARD_MAX_ORDER_VALUE="100"
PMM_GUARD_MAX_BUY_ORDER_VALUE="100"
PMM_GUARD_MAX_SELL_ORDER_VALUE="100"
PMM_GUARD_MAX_LONG_POSITION="100"
PMM_GUARD_MAX_SHORT_POSITION="100"
PMM_GUARD_MAX_DAILY_LOSS="50"
PMM_GUARD_PRICE_FLOOR="0.0001"
PMM_GUARD_PRICE_CEILING="0.9999"
PMM_METRICS_PATH="src/domains/pmm/backtest/.artifacts/logs/metrics.jsonl"
PMM_TELEGRAM_ENABLED="0"
PMM_TELEGRAM_BOT_TOKEN=""
PMM_TELEGRAM_CHAT_ID=""
PMM_TELEGRAM_API_BASE_URL="https://api.telegram.org"
PMM_TELEGRAM_REPORT_INTERVAL_SEC="1800"
PMM_TELEGRAM_ALERT_COOLDOWN_SEC="120"
PMM_TELEGRAM_SEND_STARTUP="1"

# Optional strategy overrides (JSON object)
PMM_STRATEGY_PARAMS_JSON="{}"


# =========================
# PM_ARB (Arbitrage Bot)
# =========================
PM_ARB_DRY_RUN="1"
PM_ARB_MARKET_DATA_SOURCE="mock"  # ws | rest | mock
PM_ARB_MOCK_SCENARIO="toggle"     # toggle | merge_arb | split_arb | neutral

# JSON array of pairs
# Example:
# PM_ARB_PAIRS_JSON='[{"name":"demo","yes_token_id":"...","no_token_id":"...","condition_id":"...","partition":[1,2]}]'
PM_ARB_PAIRS_JSON="[]"


# =========================
# RESEARCH (Research Pipeline)
# =========================
RESEARCH_DB_PATH="research.db"
GAMMA_BASE_URL="https://gamma-api.polymarket.com"
CLOB_BASE_URL="https://clob.polymarket.com"
RESEARCH_RATE_LIMIT_PER_SEC="5"
RESEARCH_MAX_CONCURRENCY="5"
RESEARCH_CACHE_TTL_SECONDS="300"
RESEARCH_ORDERBOOK_TOP_N="20"
RESEARCH_PROMPT_VERSION="v1"
RESEARCH_ARCHIVE_BOOKS="0"
RESEARCH_ARCHIVE_DIR="archive/books"

# Optional LLM
LLM_PROVIDER=""
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Optional Telegram notifier
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_BASE_URL="https://api.telegram.org"
