# =========================
# PMM (Market Maker)
# =========================
PMM_API_BASE_URL="http://localhost:8000"
PMM_API_KEY=""
PMM_TOKEN_IDS=""
PMM_EXECUTION_MODE="paper"   # paper | live
PMM_MARKET_DATA_SOURCE="rest" # rest | ws
PMM_STRATEGY_KEY="multi_level_v1" # single_level_v1 | multi_level_v1
PMM_DRY_RUN="1"

# Paper backtest / simulation
PMM_PAPER_INITIAL_USDC="1000"
PMM_PAPER_FILL_MODEL="conservative" # conservative | optimistic
PMM_PRICE_TICK="0.001"
PMM_BASE_SIZE="5"
PMM_MAX_POSITION="100"
PMM_METRICS_PATH="pmm_logs/metrics.jsonl"

# Optional strategy overrides (JSON object)
PMM_STRATEGY_PARAMS_JSON="{}"


# =========================
# PM_ARB (Arbitrage Bot)
# =========================
PM_ARB_API_BASE_URL="http://localhost:8000"
PM_ARB_API_KEY=""
PM_ARB_DRY_RUN="1"
PM_ARB_MARKET_DATA_SOURCE="mock"  # ws | rest | mock
PM_ARB_MOCK_SCENARIO="toggle"     # toggle | merge_arb | split_arb | neutral

# JSON array of pairs
# Example:
# PM_ARB_PAIRS_JSON='[{"name":"demo","yes_token_id":"...","no_token_id":"...","condition_id":"...","partition":[1,2]}]'
PM_ARB_PAIRS_JSON="[]"
