POLYGON_WALLET_PRIVATE_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
NEWSAPI_API_KEY=""

# Tool Service auth (optional). If set, clients must send X-API-Key.
TOOL_API_KEY=""

# News LLM filter (OpenAI-compatible)
# If NEWS_LLM_API_KEY not set, it will fall back to OPENAI_API_KEY or ALIPAY_API_KEY.
NEWS_LLM_BASE_URL="https://api.openai.com"
NEWS_LLM_API_KEY=""
NEWS_LLM_MODEL="gpt-4o-mini"
NEWS_LLM_LANG="zh"

# Optional: alternative name for provider key (used by our NEWS_LLM node fallback)
ALIPAY_API_KEY=""

# Optional: explicit CLOB api creds (normally derived from POLYGON_WALLET_PRIVATE_KEY via py_clob_client)
CLOB_API_KEY=""
CLOB_SECRET=""
CLOB_PASS_PHRASE=""
