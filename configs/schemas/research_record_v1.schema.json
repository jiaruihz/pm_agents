        "coverage": {
          "minLength": 1,
          "title": "Coverage",
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "observed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
